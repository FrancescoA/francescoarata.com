---
import Introduction from "../components/Introduction.astro";
import Footer from "../components/Footer.astro";
import { Font } from "astro:assets";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@900&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@900&display=swap"
    />
    <link rel="icon" href="/meerkat.png" />
    <meta name="generator" content={Astro.generator} />

    <Font cssVariable="--font-inter" />
    <title>Francesco Arata</title>
  </head>

  <body>
    <Introduction />

    <button id="scroll-button" class="scroll-button"> > </button>

    <div class="box-wrapper">
      <div class="info">
        <section class="skills">
          <h2>Skills</h2>
          <ul class="tech">
            <li>Python</li>
            <li>SQL</li>
            <li>R</li>
            <li>VBA</li>
            <li>TypeScript</li>
            <li>Java</li>
            <li>JS</li>
            <li>HTML</li>
            <li>CSS</li>
            <!-- <li class="learning">C++</li> -->
            <li>LLM</li>
            <li class="learning">ML</li>
          </ul>

          <hr />

          <ul class="languages">
            <li>IT</li>
            <li>EN</li>
            <li>FR</li>
            <li>DE</li>
            <li class="learning">中</li>
          </ul>

          <hr />

          <ul class="tools">
            <li>Git</li>
            <li>Pandas</li>
            <li>PyTorch</li>
            <li>Keras</li>
            <li>NumPy</li>
            <li>Excel</li>
          </ul>
        </section>

        <section class="interests">
          <h2>Interests</h2>
          <ul class="profession">
            <li>Stochastics</li>
            <li>Machine Learning</li>
            <li class="wrapped">Quantitative Modeling</li>
            <li>Algorithms</li>
            <li>Simulations</li>
            <li>Data Analysis</li>
            <li>Data Engineering</li>
          </ul>

          <hr />

          <ul class="hobby">
            <li>Math</li>
            <li>Languages</li>
            <li>Words</li>
            <li class="wrapped">Historical Linguistics</li>
            <li>Food🍕</li>
            <li>Cycletouring</li>
          </ul>
        </section>

        <section class="projects">
          <h2>Projects</h2>
          <p class="loading"></p>
        </section>

        <section class="contact">
          <h2>Let's keep in touch!</h2>
          <div class="email">
            <div class="email-tag">Email:</div>
            <div>francescoarata.me<wbr />@gmail.com</div>
          </div>
          <div class="position">📍 Milan, Italy</div>
        </section>

      </div>
    </div>

    <Footer />
  </body>
</html>

<style>

  /* UTIL */

  ::-webkit-scrollbar {
      display: none;
  }

  @-webkit-keyframes infinite-rotation {
    0% {
      transform: rotate(0deg);
    }
    100% {
      transform: rotate(360deg);
    }
  }

  body {
    background-color: #030712;
    margin: 0;
  }

  ul {
    list-style-type: none;
    padding: 0;
  }



  /* GRID CELL ASSIGNMENTS */

  .skills {
    grid-area: skills;
  }

  .interests {
    grid-area: interests;
  }

  .contact {
    grid-area: contact;
  }

  .about {
    grid-area: about;
  }

  .projects {
    grid-area: projects;
  }

  .articles {
    grid-area: articles;
  }



  /* WRAPPERS */

  .box-wrapper {
    width: 100%;
    min-width: 0;
    margin-bottom: 15rem;
  }


  .info {
    scroll-margin-top: 4rem;
    row-gap: 1rem;
    width: 50% !important;
    margin-inline: auto;
    display: grid;
    grid-template-areas:
      ". contact contact ."
      "skills skills interests interests"
      ". projects projects .";
    grid-template-columns: repeat(4, minmax(0, 1fr));
    width: 65%;
  }



  /* SECTIONS */

  section {
    margin: 2rem;
    padding: 1rem 2rem;
    border: 1px solid #4f95ff56;
    border-radius: 0.5rem;
    box-shadow: 0 0.2rem 0.2rem rgba(0, 0, 0, 0.1);
    min-width: 0;
  }

  section > h2 {
    color: rgb(255, 208, 0);
    margin-bottom: 1rem;
    font-family: monospace;
    margin-bottom: 2.5rem;
    text-decoration: underline;
    text-align: center;
    font-size: 1.4rem;
  }

  section > ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    container-type: inline-size;
    gap: 0.3rem;
  }

  section ul > li {
    width: max-content;
    max-width: 100%;
    position: relative;
    border-bottom: 1px solid rgba(255, 255, 255, 0.4);
    border-radius: 0.25rem;
    white-space: normal;
    color: #ffffff;
    font-size: 1rem;
    font-family: monospace;
    margin-bottom: 0.5rem;
    min-height: 1.5rem;
    line-height: 1.5rem;
    align-items: center;
    justify-content: center;
    cursor: default;
    user-select: none;
    background-color: #4f95ff56;
    text-align: center;
    padding: 0.4rem 0.7rem;
    transition: background-color 0.3s;
  }

  section > ul li:hover {
    background-color: #104594;
    transition: background-color 0.2s;
  }

  section ul li.learning::after {
    content: "⚙️";
    display: block;
    font-size: 1.1rem;
    position: absolute;
    top: -0.45rem;
    right: -0.6rem;
    color: #21b9ff;
    animation: infinite-rotation 3.5s linear infinite;
  }

  section hr {
    display: block;
    height: 1px;
    border: 0;
    border-top: 1px solid #cccccc5e;
    width: 40%;
    padding: 0;
  }

  section.projects,
  section.contact {
    color: white;
    font-family: monospace;
  }



  /* NAVIGATION SCROLL BUTTON */

  .scroll-button {
    position: fixed;
    display: block;
    background-color: white;
    transform: rotate(90deg);
    bottom: 2rem;
    right: 2rem;
    width: 3rem;
    height: 3rem;
    cursor: pointer;
    border-radius: 0.3rem;
    border: none;
    opacity: 1;
    visibility: visible;
    transition:
      opacity 0.3s ease,
      transform 0.3s ease,
      visibility 0.3s;
    font-family: monospace;
    text-align: center;
    font-size: 1.5rem;
    font-weight: 100;
  }

  .scroll-button.hidden {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(10px) rotate(90deg);
  }

  .scroll-button a {
    display: block;
    line-height: 3rem;
  }



  /* CONTACT */

  .contact .email-tag {
    font-size: 0.9rem;
    margin-bottom: 0.35rem;
    color: rgba(255, 255, 255, 0.712);
  }

  .contact .email {
    font-size: 1.05rem;
    overflow-wrap: normal;
    word-break: normal;
  }

  .contact .position {
    margin-top: 1.5rem;
    font-size: 0.95rem;
  }



  /* DEVICE RESPONSIVENESS */

  @media (max-width: 1600px) {
    .info {
      width: 65% !important;
      padding: 0 1.75rem;
      grid-template-columns: minmax(0, 1fr);
      row-gap: 1rem;
      grid-template:
        ". contact contact contact ."
        "skills skills interests interests interests"
        "skills skills interests interests interests"
        ". projects projects projects ."
    }
  }

  @media (max-width: 1050px) {
    .info {
      width: 55% !important;
      padding: 0 1.75rem;
      grid-template-columns: minmax(0, 1fr);
      row-gap: 1rem;
      grid-template:
        /* "about" */
        "contact"
        "skills"
        "interests"
        "projects"
    }
  }

  @media (max-width: 750px) {
    .info {
      width: auto !important;
      padding: 0 1.75rem;
      grid-template-columns: minmax(0, 1fr);
      row-gap: 1rem;
      grid-template:
        ". contact contact contact ."
        "skills skills skills skills skills"
        "interests interests interests interests interests"
        "projects projects projects projects projects"
    }
  }

  @media (max-width: 650px) {
    .info {
      width: auto !important;
      padding: 0 1.75rem;
      grid-template-columns: minmax(0, 1fr);
      row-gap: 1rem;
      grid-template:
        "contact"
        "skills"
        "interests"
        "projects"
    }
  }

  @container (max-width: 230px) {
    section ul > li.wrapped {
        width: min-content;
    }
}

</style>



<script>
  let loadingTexts = document.getElementsByClassName("loading");
  let dots = ["", ".", "..", "..."];

  let index = 0;

  function animateLoadingDots() {
    for (const text of loadingTexts) {
      text.textContent = "Soon to display" + dots[index];
      index = (index + 1) % dots.length;
    }
  }

  setInterval(animateLoadingDots, 300);
  animateLoadingDots();

  // navigation scroll-button

  const scrollButton = document.getElementById("scroll-button");
  const target = document.querySelector(".info");

  if (scrollButton && target) {
    scrollButton.addEventListener("click", () => {
      target.scrollIntoView({
        behavior: "smooth",
        block: "start",
      });
    });

    function updateButtonVisibility() {
      let targetPosition;
      let targetReached;
      if (target) {
        targetPosition = target.getBoundingClientRect().top;
        targetReached = targetPosition <= 100;
      }

      if (scrollButton) {
        scrollButton.classList.toggle("hidden", targetReached);
      }
    }

    window.addEventListener("scroll", updateButtonVisibility, {
      passive: true,
    });

    window.addEventListener("resize", updateButtonVisibility);

    updateButtonVisibility();
  }
</script>