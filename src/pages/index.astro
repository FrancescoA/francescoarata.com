---
import Introduction from "../components/Introduction.astro";
import Details from "../components/Details.astro";
import Footer from "../components/Footer.astro";
import { Font } from "astro:assets";
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <title>Francesco Arata</title>
    <link rel="icon" href="/meerkat.png" />
    
    <meta name="generator" content={Astro.generator} />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, shrink-to-fit=no" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css"/>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@900&display=swap"/>

    <Font cssVariable="--font-inter" />
  </head>

  <body>
    <Introduction />
    <Details />
    <Footer />
    
    <button id="scroll-button" class="scroll-button"> > </button>

  </body>
</html>


<style>

  /* NAVIGATION SCROLL BUTTON */

  .scroll-button {
    position: fixed;
    display: block;
    background-color: white;
    transform: rotate(90deg);
    bottom: 2rem;
    right: 2rem;
    width: 3rem;
    height: 3rem;
    cursor: pointer;
    border-radius: 0.3rem;
    border: none;
    opacity: 1;
    visibility: visible;
    transition:
      opacity 0.3s ease,
      transform 0.3s ease,
      visibility 0.3s;
    font-family: monospace;
    text-align: center;
    font-size: 1.5rem;
    font-weight: 100;
  }

  .scroll-button.hidden {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(10px) rotate(90deg);
  }

  .scroll-button a {
    display: block;
    line-height: 3rem;
  }
  
</style>