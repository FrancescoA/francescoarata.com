---
import { getLang, useTranslations } from "../i18n/utils";

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
---


<div class="intro-wrapper">
  <div class="introduction">
    <p class="size">My 44 KB piece of Internet!</p>
    <div class="menu">
      <div class="greeting">
        <span id="hand">🖐🏼</span>
        <span id="greeting" class="visible">{t("home.introduction.high-five")}</span>
      </div>

      <h1 class="name">Francesco</h1>
      <h1 class="surname">Arata</h1>
      <p id="subtitle"></p>
      <div class="description">
        <p>I am currently completing an M.Sc. in Mathematics, with a strong academic focus on stochastic calculus, stochastic processes, and advanced probability theory.</p>
        <p>I complemented my education with specific exams in quantitative risk management for banking and insurance, providing me with a theoretical foundation in risk measures and measurement, statistical methods, and financial and insurance products.</p>
        <p>In my free time I also like to implement mathematical simulations and algorithms through code.</p>
        <p>My professional interest lies in Risk Management and Quantitative Risk Analysis. I'm currently seeking an entry-level opportunity where I can apply my mathematical quantitative background, develop my expertise and contribute to practical risk-related tasks.</p>
      </div>
    </div>

    <div class="links">
      <div class="github">
        <a
          href="https://github.com/francescoa"
          target="_blank"
          rel="noopener noreferrer"
        >
          <i class="icon fa fa-github"></i>
        </a>
      </div>
    </div>
  </div>
</div>

<style>
  
  .intro-wrapper {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    width: 100%;
  }

  .introduction {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    justify-content: center;
    align-items: center;
    color: white;
    font-family: var(--font-inter);
    width: 60%;
  }

  .size {
    position: absolute;
    top: 0;
    right: 10;
    font-size: .7rem;
    font-family: monospace;
  }

  .greeting {
    font-family: monospace;
    font-size: 1.5rem;
    color: rgb(255, 208, 0);
    font-weight: 100;
    margin-bottom: 2.5rem;
    margin-top: 2.5rem;
  }

  .name,
  .surname {
    font-weight: 1200;
    font-size: clamp(3.5rem, 7vw + 2rem, 6rem);
    padding: 0;
    margin: 0;
    text-align: left;
    letter-spacing: 1px;
  }

  .name {
    color: #ffffff;
  }

  .surname {
    color: #21b9ff;
  }

  #subtitle {
    font-size: 1.25rem;
    color: #21b9ff;
    margin-top: 2.5rem;
    font-family: monospace;
  }

  #subtitle::before {
    content: ">  ";
    color: gray;
  }
  
  .description {
    margin-top: 2.5rem;
    color: rgb(185, 185, 185);
    font-size: 1.1rem;
    font-weight: 50;
    line-height: 1.35rem;
  }

  .links {
    display: flex;
    font-size: 2rem;
    gap: 1.25rem;
    margin-top: 2rem;
  }

  .icon {
    color: rgb(143, 143, 143);
  }

  .introduction {
    width: 30%;
  }

  #greeting {
    display: inline-block;
    opacity: 0;
    transition: opacity 0.2s ease-in-out;
  }

  #greeting.visible {
    opacity: 1;
  }

  #greeting.chinese {
    font-family:
      "Microsoft YaHei", "PingFang SC", "Noto Sans CJK SC",
      "Source Han Sans SC", sans-serif;
    font-weight: 500;
  }

  #hand {
    display: inline-block;
    cursor: grab;
    margin-right: 0.75rem;
    user-select: none;
    font-size: 2rem;
  }
  
</style>

<script>
  // handle subtitles loop

  const subtitle = document.getElementById("subtitle");
  let subtitleIndex = 0;
  const subtitles = ["Math", "Data", "Languages", "Everything"];

  function changeSubtitle() {
    if (!subtitle) return;

    subtitle.textContent = subtitles[subtitleIndex];
    subtitleIndex = (subtitleIndex + 1) % subtitles.length;
  }

  changeSubtitle();
  setInterval(changeSubtitle, 1000);

  // handle greetings loop

  const greeting = document.getElementById("greeting");
  const hand = document.getElementById("hand");

  const chineseGreeting = "你好！";

  const greetings = ["Ciao!", "Hi there!", "Salut!", "Hallo!", chineseGreeting];

  let greetingIndex = 0;
  let hideTimer: number | undefined;

  const visibleDuration = 500;

  if (greeting && hand) {
    hand.addEventListener("click", () => {
      clearTimeout(hideTimer);

      const isDisplayed = greeting.style.display !== "none";

      const text = greetings[greetingIndex];

      greeting.textContent = text;
      greeting.classList.toggle("chinese", text === "你好！");

      greetingIndex = (greetingIndex + 1) % greetings.length;

      if (!isDisplayed) {
        greeting.style.display = "inline-block";
        greeting.classList.remove("visible");

        void greeting.offsetWidth;
        greeting.classList.add("visible");
      } else {
        greeting.classList.add("visible");
      }

      hideTimer = setTimeout(() => {
        greeting.classList.remove("visible");
      }, visibleDuration);
    });

    greeting.addEventListener("transitionend", (event) => {
      if (
        event.propertyName === "opacity" &&
        !greeting.classList.contains("visible")
      ) {
        greeting.style.display = "none";
      }
    });
  }
</script>
