<button id="scroll-button" class="scroll-button"> > </button>



<style>

  /* NAVIGATION SCROLL BUTTON */

  .scroll-button {
    position: fixed;
    display: block;
    background-color: white;
    transform: rotate(90deg);
    bottom: 2rem;
    right: 2rem;
    width: 3rem;
    height: 3rem;
    cursor: pointer;
    border-radius: 0.3rem;
    border: none;
    opacity: 1;
    visibility: visible;
    transition:
      opacity 0.3s ease,
      transform 0.3s ease,
      visibility 0.3s;
    font-family: monospace;
    text-align: center;
    font-size: 1.5rem;
    font-weight: 100;
  }

  .scroll-button.hidden {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(10px) rotate(90deg);
  }

  .scroll-button a {
    display: block;
    line-height: 3rem;
  }
  
</style>

<script>
  
  const scrollButton = document.getElementById("scroll-button");
  const target = document.querySelector(".info");

  if (scrollButton && target) {
    scrollButton.addEventListener("click", () => {
      target.scrollIntoView({
        behavior: "smooth",
        block: "start",
      });
    });

    function updateButtonVisibility() {
      let targetPosition;
      let targetReached;
      if (target) {
        targetPosition = target.getBoundingClientRect().top;
        targetReached = targetPosition <= 100;
      }

      if (scrollButton) {
        scrollButton.classList.toggle("hidden", targetReached);
      }
    }

    window.addEventListener("scroll", updateButtonVisibility, {
      passive: true,
    });

    window.addEventListener("resize", updateButtonVisibility);

    updateButtonVisibility();
  }
</script>